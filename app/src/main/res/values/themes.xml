<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Cerimoniarios" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/primary_hover</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="colorSecondaryContainer">@color/gold_soft</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="colorSurface">@color/canvas</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorOutline">@color/border</item>
    </style>

    <style name="ThemeOverlay.Cerimoniarios.Toolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@color/white</item>
    </style>

    <style name="Widget.Cerimoniarios.AppBar" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@color/primary</item>
    </style>

    <style name="Widget.Cerimoniarios.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">?attr/actionBarSize</item>
        <item name="android:background">@color/primary</item>
        <item name="titleTextColor">@color/white</item>
        <item name="android:theme">@style/ThemeOverlay.Cerimoniarios.Toolbar</item>
    </style>

    <style name="TextAppearance.Cerimoniarios.Body" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">@color/ink</item>
        <item name="android:lineSpacingMultiplier">1.2</item>
    </style>

    <style name="TextAppearance.Cerimoniarios.Muted" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/muted</item>
    </style>

    <style name="Widget.Cerimoniarios.SectionTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleMedium</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.Cerimoniarios.Paragraph" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Cerimoniarios.Body</item>
    </style>

    <style name="Widget.Cerimoniarios.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <style name="Widget.Cerimoniarios.CardContent" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">16dp</item>
        <item name="android:textAppearance">@style/TextAppearance.Cerimoniarios.Body</item>
    </style>
</resources>
