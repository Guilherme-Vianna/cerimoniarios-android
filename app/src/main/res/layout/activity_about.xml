<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/canvas"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/app_bar"
        style="@style/Widget.Cerimoniarios.AppBar">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Cerimoniarios.Toolbar"
            app:navigationContentDescription="@string/navigate_up"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:title="@string/about_title" />
    </FrameLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_community_name"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
                android:textColor="@color/ink" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="@string/about_community_place"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@color/gold" />

            <TextView
                style="@style/Widget.Cerimoniarios.Paragraph"
                android:text="@string/about_community_intro" />

            <TextView
                style="@style/Widget.Cerimoniarios.Paragraph"
                android:text="@string/about_community_history" />

            <TextView
                style="@style/Widget.Cerimoniarios.Paragraph"
                android:text="@string/about_community_details" />

            <TextView
                style="@style/Widget.Cerimoniarios.SectionTitle"
                android:text="@string/about_patron_title" />

            <TextView
                style="@style/Widget.Cerimoniarios.Paragraph"
                android:text="@string/about_patron" />

            <TextView
                style="@style/Widget.Cerimoniarios.SectionTitle"
                android:text="@string/about_help_title" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Cerimoniarios.Card"
                android:layout_marginTop="0dp"
                app:cardBackgroundColor="@color/primary_soft">

                <TextView
                    style="@style/Widget.Cerimoniarios.CardContent"
                    android:text="@string/donation_statement" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/support_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/about_help_action"
                app:icon="@drawable/ic_favorite" />

            <TextView
                style="@style/Widget.Cerimoniarios.SectionTitle"
                android:text="@string/about_app_title" />

            <TextView
                style="@style/Widget.Cerimoniarios.Paragraph"
                android:text="@string/about_app" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/privacy_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="@string/about_privacy" />

            <TextView
                android:id="@+id/version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Cerimoniarios.Muted" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
